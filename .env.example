# local-cal configuration. Copy this file to .env and edit it.
#
# The calendar runs with zero config. Everything below only enables the optional
# morning digest. .env is gitignored, so none of this is committed.

# Port for the API (and the single-port production server).
PORT=5178
# The Vite dev client runs on 5177 (see client/vite.config.ts).

# Time to send the digest, 24h local. You can also change this in the app.
DIGEST_TIME=07:00

# Morning digest via ntfy (https://ntfy.sh), a free push notification to your phone.
# 1. Install the ntfy app (iOS/Android) or use the web app.
# 2. Set NTFY_TOPIC below to a long, random string. It works like a password:
#    anyone who knows it can read or post to your digests.
# 3. Subscribe to that exact topic in the app.
# Self-host ntfy and change NTFY_SERVER to keep everything on your own network.
NTFY_SERVER=https://ntfy.sh
NTFY_TOPIC=change-me-to-something-random-8h3ka9d2
